# Default shell (matches kitty's `shell` setting).
command = /opt/homebrew/bin/fish --login --interactive
shell-integration = fish

# Open new windows in $HOME instead of inheriting the launcher's cwd.
working-directory = home

# Transparency (matches kitty's `background_opacity`).
background-opacity = 0.9

# Quit when the last window closes, so cmd+w leaves nothing in the Dock
# (the alt-enter AeroSpace binding relaunches/reuses the app as needed).
quit-after-last-window-closed = true
